# Applies to docker builds that use the repo root as context (e.g. rag/Dockerfile).
# Keeps secrets, local indexes, and build artifacts out of the image.
.git/
**/__pycache__/
**/*.pyc
**/.DS_Store

# Node / Next build artifacts (not needed by the rag image)
node_modules/
.next/
out/

# Secrets and local vector index — must never be baked into the image
rag/.env
.env.local
rag/.chroma_db/
.venv/
